    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
